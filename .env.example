# Runtime
ENVIRONMENT=development
PORT=8000
FRONTEND_PORT=5173

# External APIs
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
OPENAI_REALTIME_SECRET_SECONDS=300
GOOGLE_SERVER_API_KEY=your_google_server_api_key_here
PLACES_PROVIDER=auto
GOOGLE_PLACES_TIMEOUT_SECONDS=10
GOOGLE_PLACES_ROUTE_SEARCH_RADIUS_KM=7.5
GOOGLE_PLACES_ROUTE_SEARCH_RADIUS_METERS=7500
GOOGLE_PLACES_NEARBY_SEARCH_RADIUS_METERS=500
GOOGLE_PLACES_SEARCH_RADIUS_METERS=7500
GOOGLE_PLACES_SAMPLE_INTERVAL_KM=50
GOOGLE_PLACES_MAX_SEARCH_POINTS=4
PROVIDER_REQUEST_BUDGET=20
# Use open-meteo for live weather without an API key; use offline for fixtures.
WEATHER_PROVIDER=open-meteo
WEATHER_ENABLED=true
WEATHER_API_KEY=
WEATHER_TIMEOUT_SECONDS=10
VITE_GOOGLE_MAPS_BROWSER_KEY=your_restricted_browser_maps_key_here
# Optional Google Cloud vector map ID. Required for 3D tilt and navigation-style camera views.
VITE_GOOGLE_MAPS_MAP_ID=your_google_vector_map_id_here

# Backend Config
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
